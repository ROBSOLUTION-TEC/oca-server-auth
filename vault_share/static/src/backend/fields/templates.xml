<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="vault.FieldShareVault"
        t-inherit="vault.FieldVault"
        t-inherit-mode="primary"
    >
        <xpath expr="//div[@t-elif='this.props.readonly']" position="attributes">
            <attribute name="t-elif">!this.isNew</attribute>
        </xpath>
    </t>

    <t
        t-name="vault.FileShareVault"
        t-inherit="web.BinaryField"
        t-inherit-mode="primary"
    >
        <xpath expr="//t[@t-if='!this.props.readonly']" position="attributes">
            <attribute name="t-if">this.isNew</attribute>
        </xpath>
    </t>

    <t t-name="vault.FieldPinVault">
        <div class="o_vault o_vault_error" t-if="!this.supported()">
            <span>*******</span>
        </div>
        <div class="o_vault" t-else="">
            <t t-call="vault.Field.buttons" />
            <span t-out="this.formattedValue" t-ref="this.span" />
        </div>
    </t>

    <t t-inherit="vault.FieldVault" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_vault_buttons')]" position="inside">
            <button
                t-if="this.shareButton"
                class="btn btn-secondary btn-sm fa fa-external-link o_vault_share"
                title="Share the secret with an external user"
                aria-label="Share the secret with an external user"
                t-on-click="this._onShareValue"
            />
        </xpath>
    </t>
</templates>
