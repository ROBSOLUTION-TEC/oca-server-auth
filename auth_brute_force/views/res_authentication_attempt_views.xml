<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_res_authentication_attempt_list" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <list
                create="0"
                decoration-warning="result == 'failed'"
                decoration-danger="result == 'banned'"
                decoration-success="result == 'successful'"
                decoration-muted="result == 'unbanned'"
            >
                <field name="create_date" />
                <field name="remote" />
                <field name="login" />
                <field name="result" />
            </list>
        </field>
    </record>

    <record id="view_res_authentication_attempt_form" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button
                        name="action_unban"
                        type="object"
                        string="Unban"
                        class="btn-primary"
                        invisible="result != 'banned'"
                    />
                    <button
                        name="action_whitelist_add"
                        type="object"
                        string="Add Remote to Whitelist"
                        invisible="whitelisted"
                    />
                    <button
                        name="action_whitelist_remove"
                        type="object"
                        string="Remove Remote from Whitelist"
                        invisible="not whitelisted"
                    />
                    <field name="result" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" />
                            <field name="login" />
                            <field name="remote" />
                            <field name="whitelisted" />
                        </group>
                        <group>
                            <field name="remote_metadata" invisible="not remote_metadata" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_authentication_attempt_graph" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="create_date" interval="day" />
                <field name="result" />
            </graph>
        </field>
    </record>

    <record id="view_res_authentication_attempt_search" model="ir.ui.view">
        <field name="model">res.authentication.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="remote" />
                <field name="login" />
                <filter
                    name="filter_no_success"
                    string="Without Success"
                    domain="[('result', '!=', 'successful')]"
                />
                <filter name="filter_banned" string="Banned" domain="[('result', '=', 'banned')]" />
                <filter name="filter_failed" string="Failed" domain="[('result', '=', 'failed')]" />
                <filter
                    name="filter_successful"
                    string="Successful"
                    domain="[('result', '=', 'successful')]"
                />
                <separator />
                <filter name="filter_today" string="Last 24h" domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]" />
                <group>
                    <filter name="group_remote" string="Remote IP" context="{'group_by': 'remote'}" />
                    <filter name="group_login" string="Login" context="{'group_by': 'login'}" />
                    <filter name="group_result" string="Result" context="{'group_by': 'result'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_res_authentication_attempt" model="ir.actions.act_window">
        <field name="name">Authentication Attempts</field>
        <field name="res_model">res.authentication.attempt</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{"search_default_filter_no_success": 1}</field>
    </record>

    <menuitem
        id="menu_res_authentication_attempt"
        parent="base.menu_users"
        action="action_res_authentication_attempt"
        groups="base.group_system"
        sequence="50"
    />
</odoo>
