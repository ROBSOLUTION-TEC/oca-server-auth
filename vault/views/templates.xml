<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="inbox">
        <t t-call="web.login_layout">
            <t t-call-assets="vault.assets_frontend" t-css="false" defer_load="True" />

            <form
                class="oe_login_form o_vault_public card shadow-sm my-4"
                role="form"
                t-attf-action="/vault/inbox/{{ token }}"
                method="post"
                onsubmit="this.action = this.action + location.hash"
            >
                <input
                    type="hidden"
                    name="csrf_token"
                    t-att-value="request.csrf_token()"
                />
                <input type="hidden" id="token" name="token" t-att-value="token" />
                <input type="hidden" id="public" name="public" t-att-value="public" />
                <input type="hidden" id="encrypted" name="encrypted" />
                <input type="hidden" id="encrypted_file" name="encrypted_file" />
                <input type="hidden" id="filename" name="filename" />
                <input type="hidden" id="iv" name="iv" />
                <input type="hidden" id="key" name="key" />

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <span
                            class="d-inline-flex align-items-center justify-content-center rounded-circle border text-primary mb-2"
                            style="width: 56px; height: 56px;"
                        >
                            <i class="fa fa-inbox fa-2x" />
                        </span>
                        <h4 class="mb-1">Send a secret</h4>
                        <p class="text-muted small mb-0">
                            The secret is encrypted in your browser before it is sent.
                            Only the recipient can open it.
                        </p>
                    </div>

                    <div class="mb-3">
                        <label for="name" class="form-label">Name of your secret</label>
                        <input
                            type="text"
                            t-if="name"
                            name="name"
                            readonly="readonly"
                            class="form-control"
                            t-att-value="name"
                        />
                        <input
                            type="text"
                            t-else=""
                            name="name"
                            required="required"
                            autofocus="autofocus"
                            placeholder="e.g. Router password"
                            class="form-control"
                        />
                    </div>

                    <div class="mb-3">
                        <label for="secret" class="form-label">Secret</label>
                        <input
                            type="password"
                            id="secret"
                            name="secret"
                            required="required"
                            autocomplete="new-password"
                            class="form-control font-monospace"
                        />
                    </div>

                    <div class="mb-3">
                        <label for="secret_file" class="form-label">File (optional)</label>
                        <input
                            type="file"
                            id="secret_file"
                            name="secret_file"
                            required="required"
                            class="form-control"
                        />
                    </div>

                    <p
                        class="alert alert-danger"
                        t-if="error"
                        role="alert"
                        t-esc="error"
                    />
                    <p
                        class="alert alert-success"
                        t-if="message"
                        role="status"
                        t-esc="message"
                    />

                    <div class="d-grid mt-2">
                        <button
                            id="submit"
                            type="submit"
                            class="btn btn-primary btn-lg"
                            disabled="disabled"
                        ><i class="fa fa-paper-plane me-1" />Submit secret</button>
                    </div>
                </div>
            </form>
        </t>
    </template>
</odoo>
